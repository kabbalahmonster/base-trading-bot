# ============================================
# BASE CHAIN CONFIGURATION (Chain ID 8453)
# ============================================
# Copy this file to .env and add your PRIVATE_KEY and ZEROX_API_KEY
#
# Usage: cp .env.base .env
# ============================================

# --------------------------------------------
# REQUIRED: API KEYS
# --------------------------------------------

# Your wallet's private key (64 hex characters, with or without 0x prefix)
# WARNING: Never share or commit this! Store it securely.
# Get from MetaMask: Account → Export Private Key
# PRIVATE_KEY=your_private_key_here

# 0x API Key for swap quotes and execution
# Get a free key at: https://0x.org/
# ZEROX_API_KEY=your_0x_api_key_here

# --------------------------------------------
# CHAIN CONFIGURATION - Base (Ethereum L2)
# --------------------------------------------

# Chain ID for Base
CHAIN_ID=8453

# RPC URL for Base
# Options:
# - https://base.llamarpc.com (default, reliable)
# - https://mainnet.base.org (official, may be rate-limited)
# - https://base.drpc.org (decentralized)
# - https://base-mainnet.g.alchemy.com/v2/YOUR_KEY (private, recommended)
RPC_URL=https://base.llamarpc.com
BASE_RPC_URL=https://base.llamarpc.com

# --------------------------------------------
# TOKEN ADDRESSES (Base Chain)
# --------------------------------------------

# USDC - US Dollar Coin (most liquid stablecoin on Base)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# WETH - Wrapped ETH for ETH-based trading pairs
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# --------------------------------------------
# GAS SETTINGS - Base Chain (L2, low cost)
# --------------------------------------------

# Gas reserve in ETH - Amount to reserve for gas fees
# Base has low gas costs but slightly higher than Robinhood
GAS_RESERVE_ETH=0.005

# --------------------------------------------
# GRID SETTINGS - Base-Optimized Defaults
# --------------------------------------------

# Grid size in USD - Amount to spend per grid position
# Base has higher gas than Robinhood, consider $20-50 per position
GRID_SIZE_USD=20

# Maximum number of grid positions to hold simultaneously
# Moderate: 24 positions (Base standard)
MAX_POSITIONS=24

# Grid spacing percentage - Distance between price levels
# Moderate: 5% (balanced approach)
GRID_SPACING_PERCENT=5

# Profit threshold percentage - Target profit per grid level
# Base has 0x API with good routing, 8% works well
PROFIT_THRESHOLD_PERCENT=8

# Minimum profit multiplier - Minimum sell price relative to cost basis
# Should account for gas costs on Base (~$0.01-0.10 per tx)
MIN_PROFIT=1.08

# Minimum amount to bank (in USD)
BANK_MIN_AMOUNT=2.0

# Moonbag percentage - Percentage of tokens to keep on sell
MOONBAG_PERCENTAGE=1

# Stop loss percentage - Maximum loss before auto-sell (negative value)
STOPLOSS_PERCENTAGE=-10

# --------------------------------------------
# TIMING SETTINGS
# --------------------------------------------

# Check interval in milliseconds - How often to scan for opportunities
# Base has fast finality (2s blocks), 10-15s works well
CHECK_INTERVAL_MS=15000

# Buy cooldown in milliseconds - Minimum time between buy executions
BUY_COOLDOWN_MS=60000

# --------------------------------------------
# FEATURE TOGGLES
# --------------------------------------------

# Enable profit banking - Move profits to USDC stablecoin
BANK_PROFIT=true

# Enable moonbag feature - Keep a percentage of tokens when selling
BANK_MOONBAG=true

# Enable sells - Allow the bot to execute sell orders
SELLS_ACTIVE=true

# Enable buys - Allow the bot to execute buy orders
BUYS_ACTIVE=true

# Grid mode: pregenerated | autogenerate | dynamic
GRID_MODE=dynamic

# Buy amount mode: static | dynamic
BUY_AMOUNT_MODE=dynamic

# --------------------------------------------
# NOTIFICATIONS (Optional)
# --------------------------------------------

# Telegram Notifications
# Get your bot token from @BotFather on Telegram
# Get your chat ID by messaging @userinfobot
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --------------------------------------------
# LOGGING
# --------------------------------------------

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --------------------------------------------
# TESTING
# --------------------------------------------

# Enable dry-run mode for testing (no real transactions)
DRY_RUN=false
