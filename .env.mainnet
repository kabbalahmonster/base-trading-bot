# ============================================
# ETHEREUM MAINNET CONFIGURATION (Chain ID 1)
# ============================================
# Copy this file to .env and add your PRIVATE_KEY and ZEROX_API_KEY
#
# WARNING: Mainnet has HIGH gas costs. Use larger position sizes.
# Usage: cp .env.mainnet .env
# ============================================

# --------------------------------------------
# REQUIRED: API KEYS
# --------------------------------------------

# Your wallet's private key (64 hex characters, with or without 0x prefix)
# WARNING: Never share or commit this! Store it securely.
# Get from MetaMask: Account → Export Private Key
# PRIVATE_KEY=your_private_key_here

# 0x API Key for swap quotes and execution (STRONGLY RECOMMENDED on Mainnet)
# Get a free key at: https://0x.org/
# ZEROX_API_KEY=your_0x_api_key_here

# --------------------------------------------
# CHAIN CONFIGURATION - Ethereum Mainnet
# --------------------------------------------

# Chain ID for Ethereum Mainnet
CHAIN_ID=1

# RPC URL for Ethereum Mainnet
# Options:
# - https://eth.llamarpc.com (default)
# - https://ethereum.publicnode.com (public)
# - https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY (private, recommended)
# - https://mainnet.infura.io/v3/YOUR_KEY (private)
RPC_URL=https://eth.llamarpc.com
ETH_RPC_URL=https://eth.llamarpc.com

# --------------------------------------------
# TOKEN ADDRESSES (Ethereum Mainnet)
# --------------------------------------------

# USDC - US Dollar Coin (most liquid stablecoin on Mainnet)
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# WETH - Wrapped ETH for ETH-based trading pairs
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# --------------------------------------------
# GAS SETTINGS - Ethereum Mainnet (HIGH GAS!)
# --------------------------------------------

# Gas reserve in ETH - Amount to reserve for gas fees
# Mainnet has HIGH gas costs ($5-50+ per transaction during congestion)
# Keep plenty of ETH reserved for gas: 0.05+ ETH recommended
GAS_RESERVE_ETH=0.05

# --------------------------------------------
# GRID SETTINGS - Mainnet-Optimized Defaults
# --------------------------------------------

# Grid size in USD - Amount to spend per grid position
# Mainnet has HIGH gas costs, need larger positions to be profitable
# Minimum recommended: $100+ per position
GRID_SIZE_USD=100

# Maximum number of grid positions to hold simultaneously
# Fewer positions due to higher capital requirements
MAX_POSITIONS=12

# Grid spacing percentage - Distance between price levels
# Wider spacing recommended due to gas costs
GRID_SPACING_PERCENT=8

# Profit threshold percentage - Target profit per grid level
# Higher profit needed to cover mainnet gas costs
PROFIT_THRESHOLD_PERCENT=12

# Minimum profit multiplier - Minimum sell price relative to cost basis
# Must cover gas costs which can be $10-50+ per trade
MIN_PROFIT=1.12

# Minimum amount to bank (in USD)
# Higher threshold due to gas costs
BANK_MIN_AMOUNT=10.0

# Moonbag percentage - Percentage of tokens to keep on sell
MOONBAG_PERCENTAGE=5

# Stop loss percentage - Maximum loss before auto-sell (negative value)
# Wider stop loss recommended due to mainnet volatility
STOPLOSS_PERCENTAGE=-15

# --------------------------------------------
# TIMING SETTINGS
# --------------------------------------------

# Check interval in milliseconds - How often to scan for opportunities
# Mainnet has 12s block time, check every 30-60s
CHECK_INTERVAL_MS=30000

# Buy cooldown in milliseconds - Minimum time between buy executions
# Longer cooldown due to gas costs
BUY_COOLDOWN_MS=300000

# --------------------------------------------
# FEATURE TOGGLES
# --------------------------------------------

# Enable profit banking - Move profits to USDC stablecoin
BANK_PROFIT=true

# Enable moonbag feature - Keep a percentage of tokens when selling
BANK_MOONBAG=true

# Enable sells - Allow the bot to execute sell orders
SELLS_ACTIVE=true

# Enable buys - Allow the bot to execute buy orders
BUYS_ACTIVE=true

# Grid mode: pregenerated | autogenerate | dynamic
GRID_MODE=dynamic

# Buy amount mode: static | dynamic
BUY_AMOUNT_MODE=dynamic

# --------------------------------------------
# NOTIFICATIONS (Optional but Recommended)
# --------------------------------------------

# Telegram Notifications - HIGHLY RECOMMENDED for mainnet
# Get your bot token from @BotFather on Telegram
# Get your chat ID by messaging @userinfobot
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --------------------------------------------
# LOGGING
# --------------------------------------------

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --------------------------------------------
# TESTING
# --------------------------------------------

# Enable dry-run mode for testing (no real transactions)
# STRONGLY RECOMMENDED to test on mainnet first with DRY_RUN=true
DRY_RUN=false

# --------------------------------------------
# MAINNET WARNINGS
# --------------------------------------------
# 
# 1. Gas costs can spike during network congestion
# 2. Always monitor your gas reserve
# 3. Use larger position sizes to justify gas costs
# 4. Consider starting with Base or Robinhood for testing
# 5. Use a hardware wallet for large amounts
#
